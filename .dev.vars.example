# Copy to .dev.vars for local preview. .dev.vars is not committed.
# Live values are Worker secrets, set through the Cloudflare API (never in git).
NEXTJS_ENV=development

# Signs and encrypts dashboard data (password pre-hash, authenticator secrets,
# hashed addresses). At least 32 characters; the Worker refuses any value containing "change-me". Changing it signs everyone out and
# invalidates every stored password, so set it once.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_PEPPER=change-me-generate-with-the-command-above

# One-time code that unlocks /admin/setup while no owner exists. 20+ random characters, never a placeholder.
# Run setup right after the first deploy, then delete SETUP_CODE.
SETUP_CODE=change-me-generate-20-or-more-random-characters

# Bearer token the site build uses to read /api/content/export. 32+ random characters, never a placeholder.
EXPORT_TOKEN=change-me-generate-32-or-more-random-characters

# Workers Builds deploy hook URL for the Publish button. Leave empty locally:
# the dashboard then shows "not set up" instead of publishing.
DEPLOY_HOOK_URL=
# Email codes for a forgotten password (Resend, https://resend.com). Without the key the
# sign-in screen says email codes are not set up and password sign-in works as before.
# Live: a Worker secret, never in git. Until a domain is verified in Resend, mail can only be
# sent from onboarding@resend.dev to the address that owns the Resend account.
RESEND_API_KEY=
# Sender. Also a plain var in wrangler.jsonc; set it here only to override locally.
# RESEND_FROM=Delta Furnishings <onboarding@resend.dev>
# Local development only: send the code to the stub (node worker/dev/email-stub.mjs) instead of Resend.
# Honoured only when NEXTJS_ENV=development and the address is loopback; worker/dev/start.mjs sets it.
# DEV_EMAIL_STUB=http://127.0.0.1:8799

# Copy to .dev.vars for local preview. .dev.vars is not committed.
# Live values are Worker secrets, set through the Cloudflare API (never in git).
NEXTJS_ENV=development

# Signs and encrypts dashboard data (password pre-hash, authenticator secrets,
# hashed addresses). 32+ random bytes. Changing it signs everyone out and
# invalidates every stored password, so set it once.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_PEPPER=change-me-32-random-bytes-base64url

# One-time code that unlocks /admin/setup while no owner exists. 8+ characters.
SETUP_CODE=change-me-one-time-first-run-code

# Bearer token the site build uses to read /api/content/export. 24+ characters.
EXPORT_TOKEN=change-me-random-24-or-more-characters

# Workers Builds deploy hook URL for the Publish button. Leave empty locally:
# the dashboard then shows "not set up" instead of publishing.
DEPLOY_HOOK_URL=

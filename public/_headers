# Headers for files served straight from Workers Static Assets. They do not
# reach responses made by Worker code, so lib/server/headers.ts adds the same
# set to pages and photos the Worker answers. Keep the two in step.
# Rules are applied in order; matching rules add up (max 100 rules).

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000
  Cross-Origin-Opener-Policy: same-origin
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: frame-ancestors 'self'; object-src 'none'; base-uri 'self'; form-action 'self'

/_next/static/*
  Cache-Control: public,max-age=31536000,immutable

# Photos copied next to the pages by the build: the file name holds the
# content hash, so they never change.
/m/*
  Cache-Control: public,max-age=31536000,immutable

# Dashboard pages are answered by the Worker (pre-rendered cache), which adds the same policy plus the hashes of the page's inline scripts (lib/server/headers.ts).
# Dashboard: never embedded, never indexed, no referrer.
/admin
  ! X-Frame-Options
  ! Referrer-Policy
  ! Content-Security-Policy
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; style-src-attr 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'
  X-Robots-Tag: noindex, nofollow, noarchive

/admin/*
  ! X-Frame-Options
  ! Referrer-Policy
  ! Content-Security-Policy
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; style-src-attr 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'
  X-Robots-Tag: noindex, nofollow, noarchive

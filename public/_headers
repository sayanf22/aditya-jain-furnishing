# Whole-site policy. Pages are pre-rendered, so Next.js puts its hydration data in inline
# scripts that cannot carry a per-request nonce (Next.js CSP guide: nonces need dynamic
# rendering); the Worker adds the SHA-256 of each page's inline scripts instead (lib/server/headers.ts).
# Here, for static files, scripts come only from this site and Cloudflare Turnstile. Everything else is closed: no plugins,
# no foreign frames, forms and base only to this site, https forced.
# Headers for files served straight from Workers Static Assets. They do not
# reach responses made by Worker code, so lib/server/headers.ts adds the same
# set to pages and photos the Worker answers. Keep the two in step.
# Rules are applied in order; matching rules add up (max 100 rules).

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000
  Cross-Origin-Opener-Policy: same-origin
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; frame-src https://challenges.cloudflare.com; media-src 'self'; manifest-src 'self'; worker-src 'self'; frame-ancestors 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests

/_next/static/*
  Cache-Control: public,max-age=31536000,immutable

# Photos copied next to the pages by the build: the file name holds the
# content hash, so they never change.
/m/*
  Cache-Control: public,max-age=31536000,immutable
  Cross-Origin-Resource-Policy: same-origin
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'none'; style-src 'unsafe-inline'; sandbox

# Dashboard pages are answered by the Worker (pre-rendered cache), which adds the same policy plus the hashes of the page's inline scripts (lib/server/headers.ts).
# Dashboard: never embedded, never indexed, no referrer.
/admin
  ! X-Frame-Options
  ! Referrer-Policy
  ! Content-Security-Policy
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; style-src-attr 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'
  X-Robots-Tag: noindex, nofollow, noarchive

/admin/*
  ! X-Frame-Options
  ! Referrer-Policy
  ! Content-Security-Policy
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; style-src-attr 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'
  X-Robots-Tag: noindex, nofollow, noarchive

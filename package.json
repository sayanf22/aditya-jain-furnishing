{
  "name": "aditya-jain-furnishing",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run cf-typegen && npm run db:migrate:local",
    "build": "next build",
    "lint": "eslint",
    "typecheck": "npm run cf-typegen && tsc --noEmit",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:seed:demo": "wrangler d1 execute DB --local --file seeds/demo-local.sql",
    "perf": "node scripts/perf-check.mjs",
    "cpu": "node scripts/cpu-profile.mjs",
    "stock": "node scripts/stock/fetch-stock.mjs"
  },
  "overrides": {
    "@node-minify/core": {
      "glob": "^10.5.0"
    }
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.15",
    "next": "16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "wrangler": "^4.156.0"
  }
}

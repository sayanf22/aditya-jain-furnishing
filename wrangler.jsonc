{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aditya-jain-furnishing",
  // Local-only build for now: don't send Wrangler usage data to Cloudflare.
  "send_metrics": false,
  // Custom entry: routes /api/* to light handlers, everything else to the
  // OpenNext handler in .open-next/worker.js (see worker/index.ts).
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  // Next.js build files (JS, CSS, pre-rendered pages). Requests for these
  // files are free and don't count toward the daily Worker request limit.
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Catalogue data and enquiries. No database_id yet: Wrangler creates the
  // database in the client's Cloudflare account on first deploy.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aditya-jain-furnishing-db",
      "migrations_dir": "migrations"
    }
  ],
  // Product photos, décor images and Watch & Buy look photos (no video).
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "aditya-jain-furnishing-media"
    }
  ],
  // Enquiry form: at most 5 submissions a minute per visitor (free plan).
  "ratelimits": [
    {
      "name": "ENQUIRY_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  "upload_source_maps": true,
  "observability": {
    "enabled": true
  }
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aditya-jain-furnishing",
  // Local-only build for now: don't send Wrangler usage data to Cloudflare.
  "send_metrics": false,
  // Custom entry: routes /api/* to light handlers, everything else to the
  // OpenNext handler in .open-next/worker.js (see worker/index.ts).
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  // Next.js build files (JS, CSS, pre-rendered pages). Requests for these
  // files are free and don't count toward the daily Worker request limit.
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Four D1 databases, split by what they hold (Workers Free allows 10):
  //   DB        content the site is built from: collections, products, photos
  //             list, site settings. Read at build time; nothing private.
  //   AUTH_DB   dashboard owner accounts, sessions, sign-in throttling.
  //   ENQ_DB    enquiry form submissions (names and phone numbers).
  //   AUDIT_DB  who changed what in the dashboard.
  // Locally Wrangler uses its own copy of each; these ids are the live ones in
  // the client's account (ids are not secrets).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aditya-jain-furnishing-db",
      "database_id": "e276b4c6-1956-4596-acd2-be1cab2769cd",
      "migrations_dir": "migrations"
    },
    {
      "binding": "AUTH_DB",
      "database_name": "delta-auth-db",
      "database_id": "4ead6ba4-a52a-40e4-928a-fe56810f7181",
      "migrations_dir": "migrations-auth"
    },
    {
      "binding": "ENQ_DB",
      "database_name": "delta-enquiries-db",
      "database_id": "b41b3256-0cd0-4416-986d-0663380d77d9",
      "migrations_dir": "migrations-enquiries"
    },
    {
      "binding": "AUDIT_DB",
      "database_name": "delta-audit-db",
      "database_id": "611fc202-0d70-44cd-a1b4-13f7b3bd4189",
      "migrations_dir": "migrations-audit"
    }
  ],
  // Photos uploaded from the dashboard: m/<hash>-<width>.webp. The site build
  // copies the ones in use next to the pages (free static files); the Worker
  // serves the rest straight from here.
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "delta-furnishings-media"
    }
  ],
  // Rate limits (free plan): enquiry form, dashboard sign-in, dashboard API.
  "ratelimits": [
    {
      "name": "ENQUIRY_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    },
    {
      "name": "LOGIN_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 6, "period": 60 }
    },
    {
      "name": "ADMIN_LIMITER",
      "namespace_id": "1003",
      "simple": { "limit": 240, "period": 60 }
    }
  ],
  // Plain settings (not secrets). RESEND_API_KEY is a secret and is set outside git.
  // Without a verified domain Resend only sends from onboarding@resend.dev to the account owner's own address.
  "vars": {
    "RESEND_FROM": "Delta Furnishings <onboarding@resend.dev>"
  },
  "upload_source_maps": true,
  "observability": {
    "enabled": true
  }
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aditya-jain-furnishing",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "html_handling": "none",
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": [
      "/*",
      "!/_next/static/*",
      "!/*/_next/static/*"
    ]
  },
  // Catalogue data and enquiries. No database_id yet: Wrangler creates the
  // database in the client's Cloudflare account on first deploy.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aditya-jain-furnishing-db",
      "migrations_dir": "migrations"
    }
  ],
  // Product photos, décor images and Watch & Buy videos.
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "aditya-jain-furnishing-media"
    }
  ],
  "observability": {
    "enabled": true
  }
}
